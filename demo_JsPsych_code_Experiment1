var timeline = [];

var preload = {
    type: 'preload',
    auto_preload: true 
}
timeline.push(preload);

var Welcome = {
   type: 'html-button-response',
   stimulus: '<p>Welcome to the demo of the experiment!</p>',
 choices: ['Begin']
 }
 
 timeline.push(Welcome);
 

 
