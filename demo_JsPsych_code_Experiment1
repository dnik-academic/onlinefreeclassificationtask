            `<p> You will see a big hollow circle and eight smaller circles around it. Hover over each circle to listen to it.<p/>`,
            ],
            show_clickable_nav: true,
            response_ends_trial: true
        }           
   
   var instructions2 = {
            type: 'instructions',
